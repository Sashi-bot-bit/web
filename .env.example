# Copy to .env for local development. Production values live in Vercel.
DATABASE_URL="postgresql://USER@localhost:5432/campus_eats_dev" # Neon pooled URL in Vercel
BETTER_AUTH_SECRET="" # openssl rand -base64 32 (different from the admin secret)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SHOP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Campus Eats"
REVALIDATE_SECRET="" # same value as the admin repo
RESEND_API_KEY="" # optional locally (emails print to the console); required in production
EMAIL_FROM="Campus Eats <orders@example.com>"
ORDER_LINK_SECRET="" # openssl rand -hex 32 — same value in both repos
